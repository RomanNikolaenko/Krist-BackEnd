# Copy to .env and fill in. Never commit the real file.

NODE_ENV=development
PORT=3000

# --- data -------------------------------------------------------------------
# PostgreSQL is the authoritative store. Redis holds only disposable state.
DATABASE_URL=postgresql://krist:krist@localhost:5432/krist?schema=public
REDIS_URL=redis://localhost:6379

# --- browser client ---------------------------------------------------------
# The only origin allowed to send credentialed requests. Add more, comma
# separated, in CORS_ORIGINS — never a wildcard, browsers reject it with
# credentials anyway.
FRONTEND_URL=http://localhost:4200
# CORS_ORIGINS=https://admin.krist.example

# --- session ----------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-at-least-32-random-characters

# Leave COOKIE_SECURE unset to follow NODE_ENV; it cannot be false in production.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=.krist.example
# lax is right when the API and the app share a site. Use none (with Secure)
# only if they are on genuinely different sites.
COOKIE_SAME_SITE=lax

# Seconds. Idle expires a quiet session; max age is the ceiling regardless.
SESSION_IDLE_TIMEOUT=604800
SESSION_MAX_AGE=2592000

# --- policy -----------------------------------------------------------------
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=3600
REQUIRE_VERIFIED_EMAIL=false

# --- mail -------------------------------------------------------------------
# log writes the message to the console and tmp/mail — enough to walk the
# verification and reset flows without an SMTP account.
MAIL_TRANSPORT=log
MAIL_FROM=Krist <no-reply@krist.local>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_SIGNUP_WINDOW=3600
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_WINDOW=3600

# --- deployment -------------------------------------------------------------
# Only with a proxy you control in front, or clients can forge their own IP.
TRUST_PROXY=false

# --- seed (optional) --------------------------------------------------------
# SEED_ADMIN_EMAIL=admin@krist.local
# SEED_ADMIN_PASSWORD=
